# Copy to .env.docker on the EC2 host (git-ignored) and fill in real values.

# --- MongoDB Atlas ---
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net
DB_NAME=lokdarpan

# --- Auth ---
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# --- AWS S3 (uploads + HLS output) ---
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# --- Identity verification ---
# Admins who can review manual ID verifications at /admin/verifications.
# Sign up the admin account FIRST, then list its email here (signup does not verify email ownership).
ADMIN_EMAILS=
# Bucket for ID photos. Use a dedicated PRIVATE bucket; falls back to S3_BUCKET_NAME.
S3_PRIVATE_BUCKET_NAME=
# Leave empty to use manual review; set both once DigiLocker is approved.
# DIGILOCKER_CLIENT_ID=
# DIGILOCKER_CLIENT_SECRET=

# --- Optional tuning ---
# TRANSCODE_ENCODE_CONCURRENCY=1
# FFMPEG_PRESET=veryfast
# DELETE_RAW_AFTER_TRANSCODE=false

# REDIS_URL, PORT and NODE_ENV are already set inside the image.
# Vercel (client) needs its own env vars: API_URL, VITE_API_URL, SESSION_SECRET.
