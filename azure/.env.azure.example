# ==============================================================================
# LokDarpan Environment Configuration: Azure + Vercel + Cloudflare R2 Architecture
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AZURE COSMOS DB FOR MONGODB (Database)
# Free Tier: 1,000 RU/s provisioned throughput, 25 GB storage (Always Free)
# Format: mongodb://<ACCOUNT_NAME>:<KEY>@<ACCOUNT_NAME>.mongo.cosmos.azure.com:10255/?ssl=true&replicaSet=globaldb&retrywrites=false&maxIdleTimeMS=120000&appName=@<ACCOUNT_NAME>@
# ------------------------------------------------------------------------------
MONGO_URI=mongodb://lokdarpan-cosmos:PRIMARY_KEY_HERE@lokdarpan-cosmos.mongo.cosmos.azure.com:10255/?ssl=true&replicaSet=globaldb&retrywrites=false&maxIdleTimeMS=120000&appName=@lokdarpan-cosmos@
DB_NAME=lokdarpan

# ------------------------------------------------------------------------------
# 2. AZURE CONTAINER APPS (Backend API Service)
# Free Tier: 180,000 vCPU-sec, 360,000 GiB-sec, 2M requests/month (Always Free)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=5000
HOST=0.0.0.0
API_PREFIX=/api/v1

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECRECY
# Generate with: openssl rand -base64 32
# ------------------------------------------------------------------------------
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d
CRON_SECRET=secret_key_used_by_azure_functions_timer_triggers

# ------------------------------------------------------------------------------
# 4. CLOUDFLARE R2 (Cloud Storage for Videos, HLS Segments & Thumbnails)
# Free Tier: 10 GB storage, 1M writes, 10M reads/month, $0 Egress Fees Forever
# Obtain credentials from Cloudflare Dashboard > R2 > Manage R2 API Tokens
# ------------------------------------------------------------------------------
AWS_REGION=auto
AWS_ACCESS_KEY_ID=your_cloudflare_r2_access_key_id
AWS_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_access_key
S3_BUCKET_NAME=lokdarpan-media
S3_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com
# Public domain where uploaded videos and playlists are served (R2 Public Bucket or Custom Domain)
STORAGE_PUBLIC_URL=https://media.yourdomain.com
# Optional private bucket for identity verification docs (falls back to main bucket with private keys)
S3_PRIVATE_BUCKET_NAME=lokdarpan-private-docs

# ------------------------------------------------------------------------------
# 5. REDIS (BullMQ Transcode Queues & Recommendation Cache)
# Options:
#  A) Upstash Serverless Redis (Free Tier: 10,000 requests/day, 256MB)
#  B) Built-in container Redis: redis://127.0.0.1:6379 (Runs inside Docker image via supervisord)
# ------------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379

# ------------------------------------------------------------------------------
# 6. IDENTITY & ADMIN
# ------------------------------------------------------------------------------
ADMIN_EMAILS=admin@lokdarpan.com
# DIGILOCKER_CLIENT_ID=
# DIGILOCKER_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 7. VERCEL FRONTEND (Remix Client Environment Variables)
# Add these in Vercel Project Settings > Environment Variables:
# ------------------------------------------------------------------------------
# API_URL=https://lokdarpan-api.centralindia.azurecontainerapps.io
# VITE_API_URL=https://lokdarpan-api.centralindia.azurecontainerapps.io
# SESSION_SECRET=another_super_secret_session_key_32_chars_long
